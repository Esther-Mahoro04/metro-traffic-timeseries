# Copy to .env if you need to override the defaults in api/config.py.
# These match docker-compose.yml for a database stack running on this machine.

MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=root
MYSQL_DATABASE=traffic_db

MONGO_URI=mongodb://127.0.0.1:27017
MONGO_DB=traffic_db
MONGO_COLLECTION=traffic
